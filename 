@charset "UTF-8";
@import url("https://fonts.googleapis.com/css2?family=Jersey+10&family=Jersey+15&family=Jersey+20&family=Jersey+25&display=swap");
.mobile-only {
  display: none;
}
@media only screen and (max-width: 767px) {
  .mobile-only {
    display: unset;
  }
}

.desktop-only {
  display: unset;
}
@media only screen and (max-width: 767px) {
  .desktop-only {
    display: none;
  }
}

@font-face {
  font-family: "Proxima Nova";
  src: url("../assets/fonts/proximanova_light.otf") format("opentype");
  font-weight: 300;
  font-style: normal;
}
@font-face {
  font-family: "Proxima Nova";
  src: url("../assets/fonts/proximanova_regular.ttf") format("opentype");
  font-weight: 400;
  font-style: normal;
}
@font-face {
  font-family: "Proxima Nova";
  src: url("../assets/fonts/proximanova_bold.otf") format("opentype");
  font-weight: 700;
  font-style: normal;
}
@font-face {
  font-family: "Proxima Nova";
  src: url("../assets/fonts/proximanova_boldit.otf") format("opentype");
  font-weight: 700;
  font-style: italic;
}
@font-face {
  font-family: "Proxima Nova";
  src: url("../assets/fonts/proximanova_extrabold.otf") format("opentype");
  font-weight: 800;
  font-style: normal;
}
@font-face {
  font-family: "Proxima Nova";
  src: url("../assets/fonts/proximanova_black.otf") format("opentype");
  font-weight: 900;
  font-style: normal;
}
@font-face {
  font-family: "Proxima Nova";
  src: url("../assets/fonts/proximanova_blackit.otf") format("opentype");
  font-weight: 900;
  font-style: italic;
}
:root {
  --pixel-border-regular: url('../../assets/buttons/button-pixel-border-regular-light.png');
  --frame-border: url('../../assets/about/frame2.png');
}

.dark-mode {
  --pixel-border-regular: url('../../assets/buttons/button-pixel-border-regular-dark.png');
}

.aboutus-page-components {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-top: 40px;
}
@media only screen and (max-width: 767px) {
  .aboutus-page-components {
    margin-top: 20px;
  }
}

.about-contents-container {
  margin: 50px;
}

.about-page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  background-color: purple;
}

.about-introduction-title {
  text-align: center;
  font-size: 60px;
  color: var(--text-primary);
  margin-top: 50px;
  font-family: "Genty", sans-serif;
  letter-spacing: 2px;
}
@media only screen and (max-width: 767px) {
  .about-introduction-title {
    margin-top: 25px;
    font-size: 40px;
  }
}

.aboutus-subsubcontainer {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 40px;
  margin-top: 40px;
  align-items: start;
}
@media (max-width: 1000px) {
  .aboutus-subsubcontainer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 !important;
    padding: 0 !important;
    text-align: center;
  }
}

.aboutus-image-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 13px 0;
  background-color: var(--mikado);
  border: 24px solid transparent;
  border-image-source: var(--frame-border);
  border-image-slice: 200;
  border-image-repeat: repeat;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  height: auto;
  max-width: 100%;
}

@media (max-width: 1000px) {
  .aboutus-image-container {
    width: 70vw;
    margin: 0 0 25px 0;
  }
}
.aboutus-image {
  object-fit: contain;
  height: 100%;
  width: 100%;
}

.aboutus-info-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  justify-content: center;
  max-width: 1000px;
}
@media (max-width: 1000px) {
  .aboutus-info-container {
    width: 95vw;
  }
}

.aboutus-info {
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  padding: 20px 40px;
}
@media (max-width: 1000px) {
  .aboutus-info {
    margin: 0;
    padding: 20px;
  }
}

.aboutus-info-title {
  font-size: 32px;
  margin-bottom: 12px;
  color: var(--text-primary);
  text-align: left;
  font-family: "Genty", sans-serif;
  font-weight: 800;
  letter-spacing: 1px;
}
@media (max-width: 1000px) {
  .aboutus-info-title {
    text-align: center;
    font-size: 24px;
  }
}

.aboutus-info-des {
  font-size: 20px;
  color: var(--text-primary);
  font-family: "Gliker", sans-serif;
  font-weight: 400;
  line-height: 1.5;
}
@media only screen and (max-width: 767px) {
  .aboutus-info-des {
    font-size: 16px;
  }
}

.exec-game-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  justify-items: center;
  gap: 40px;
  width: 90vw;
  max-width: 1200px;
  margin: 20px auto 60px auto;
}
@media only screen and (max-width: 767px) {
  .exec-game-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }
}
.exec-game-container button {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
}
.exec-game-container button:focus {
  outline: none;
}

.exec-game-machine-large {
  width: 100%;
  max-width: 400px;
  height: auto;
  cursor: url("../../assets/cursor/pointer.png"), auto;
}
@media only screen and (max-width: 767px) {
  .exec-game-machine-large {
    display: none;
  }
}

.exec-game-machine-small {
  display: none;
  width: 60%;
  max-width: 280px;
  cursor: url("../../assets/cursor/pointer.png"), auto;
  margin: 30px auto;
}
@media only screen and (max-width: 767px) {
  .exec-game-machine-small {
    display: block;
  }
}

.exec-info-container {
  width: 100%;
  background: rgba(0, 0, 0, 0.15);
  padding: 40px;
  border-radius: 16px;
  border: 3px dashed var(--text-primary);
}
@media only screen and (max-width: 767px) {
  .exec-info-container {
    width: 90%;
    padding: 20px;
  }
}
.exec-info-container h1 {
  text-align: center;
  font-size: 60px;
  letter-spacing: 3px;
  color: var(--text-coloured);
  font-family: "Genty", sans-serif;
  margin-bottom: 10px;
}
@media only screen and (max-width: 767px) {
  .exec-info-container h1 {
    font-size: 38px;
  }
}
.exec-info-container h2 {
  font-family: "Gliker", sans-serif;
  letter-spacing: 2px;
  font-size: 30px;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 20px;
}
.exec-info-container p {
  text-align: center;
  font-size: 1.1rem;
  color: var(--text-primary);
  font-family: "Gliker", sans-serif;
  font-weight: 400;
  line-height: 1.6;
}

.exec-img {
  width: 220px;
  height: 220px;
  object-fit: cover;
  display: block;
  margin: 20px auto;
  border-radius: 50%;
  border: 4px solid var(--bg-primary);
}

.toggle-container {
  display: flex;
  justify-content: center;
  width: 100%;
}

.exec-display-toggle {
  background-color: var(--bg-secondary);
  width: 240px;
  height: 60px;
  margin-bottom: 40px;
  border-radius: 100px;
  cursor: url("../../assets/cursor/cursor.png"), auto !important;
  display: flex;
  align-items: center;
  padding: 4px;
  border: 3px solid var(--bg-primary);
  transition: background-color 150ms ease-in-out;
}

.thumb {
  background-color: var(--bg-primary);
  width: 120px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 100px;
  text-align: center;
  font-family: "Gliker", sans-serif;
  color: var(--text-secondary);
  font-size: 15px;
  font-weight: 900;
  text-transform: uppercase;
  transition: transform 250ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
}

.game-view .thumb {
  transform: translateX(0px);
}

.card-view .thumb {
  transform: translateX(106px);
}

.aboutus-oc-grid-container,
.aboutus-vc-grid-container,
.aboutus-techteam-grid-container {
  display: grid;
  width: 100%;
  max-width: 1400px;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 30px;
  align-items: center;
  justify-items: center;
  justify-content: center;
  margin: 0 auto 40px auto;
  padding: 0 40px;
}
@media only screen and (max-width: 767px) {
  .aboutus-oc-grid-container,
  .aboutus-vc-grid-container,
  .aboutus-techteam-grid-container {
    display: flex;
    flex-direction: column;
    padding: 0 20px;
  }
}

.executive-title {
  color: var(--text-primary);
  font-family: "Genty", sans-serif;
  font-size: 48px;
  font-weight: 900;
  margin-bottom: 30px;
  text-align: center;
}
@media only screen and (max-width: 767px) {
  .executive-title {
    font-size: 36px;
    padding: 0 10px;
  }
}

.about-attribution-container {
  display: flex;
  flex-direction: column;
  width: 100vw;
  padding: 50px;
  text-align: center;
  color: var(--text-primary);
}
@media only screen and (max-width: 767px) {
  .about-attribution-container {
    width: 85vw;
    padding: 25px 0;
  }
}

.text-link-dark {
  color: var(--link-dynamic);
}

.aboutus-teams-all-tabs {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  width: 100%;
  padding-top: 50px;
  padding-left: 6vw;
  align-items: center;
}
@media only screen and (max-width: 767px) {
  .aboutus-teams-all-tabs {
    width: 100%;
    padding: 0;
  }
}

.aboutus-teams-all-tabs-scroll {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}
@media only screen and (max-width: 767px) {
  .aboutus-teams-all-tabs-scroll {
    justify-content: flex-start;
    width: 100%;
    padding: 0 30px;
    overflow-x: scroll;
  }
  .aboutus-teams-all-tabs-scroll::-webkit-scrollbar {
    height: 3px;
  }
  .aboutus-teams-all-tabs-scroll::-webkit-scrollbar-track {
    background: var(--transparent);
  }
  .aboutus-teams-all-tabs-scroll::-webkit-scrollbar-thumb {
    background: var(--light-purple);
  }
}

.aboutus-teams-tabs {
  color: var(--aboutus-tabs-color) !important;
  padding: 15px 0;
  transition: color 200ms;
}
.aboutus-teams-tabs:hover {
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
}
.aboutus-teams-tabs:hover .aboutus-yellow-bubble {
  background-color: var(--bg-primary);
  width: 100%;
}

.aboutus-teams-tabs-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  text-align: center;
}
@media only screen and (max-width: 767px) {
  .aboutus-teams-tabs-container {
    width: max-content;
  }
}

.aboutus-short-vertical-line {
  height: 35px;
  width: 3px;
  background-color: var(--bg-primary);
  border-radius: 5px;
  margin: 0 28px;
}
@media only screen and (max-width: 767px) {
  .aboutus-short-vertical-line {
    height: 26px;
    width: 2px;
    align-self: start;
  }
}

.aboutus-teams-tabs-title {
  transition: color 200ms;
  font-family: "Gliker", sans-serif;
}
@media only screen and (max-width: 767px) {
  .aboutus-teams-tabs-title {
    font-size: 20px;
  }
}

.aboutus-teams-tabs-title-selected {
  color: var(--text-primary);
  transition: color 200ms;
  font-family: "Gliker", sans-serif;
  font-size: 48px;
  font-weight: 900;
  margin-bottom: 20px;
  text-align: left !important;
}

.aboutus-yellow-bubble {
  margin-top: 10px;
  opacity: 0;
  width: 0%;
  height: 4px;
  border-radius: 80px;
  background-color: var(--bg-primary);
  transition: width 400ms, opacity 400ms;
}

.aboutus-yellow-bubble-show {
  width: 100%;
  background-color: var(--bg-primary) !important;
  opacity: 1;
}

.aboutus-yellow-bubble-noshow {
  width: 0%;
  opacity: var(--transparent);
}

.aboutus-hl-grid-container {
  display: grid;
  width: 90vw;
  grid-template-columns: repeat(auto-fit, 240px);
  align-items: center;
  justify-items: center;
  justify-content: center;
  place-items: center;
  margin-bottom: 25px;
}
@media only screen and (max-width: 767px) {
  .aboutus-hl-grid-container {
    grid-template-columns: auto auto;
  }
}

.aboutus-hl-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 200px;
  height: 200px;
  margin: 20px;
  background-color: var(--bg-primary);
  border-radius: 10px;
  color: var(--text-primary);
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
}
@media only screen and (max-width: 767px) {
  .aboutus-hl-container {
    width: 160px;
    height: 160px;
    margin: 5px;
  }
}
.aboutus-hl-container .aboutus-hl-frosh-group-spin {
  transform: rotateY(360deg);
  transition: transform 1000ms;
}

.aboutus-hl-container-show {
  z-index: 5;
  opacity: 1;
  transition: opacity 300ms;
}

.aboutus-hl-container-hide {
  pointer-events: none;
  opacity: 0;
  transition: opacity 300ms;
}

.aboutus-hl-frosh-group-container {
  display: flex;
  flex-direction: column;
  text-align: center;
  margin-bottom: 15px;
  color: var(--text-primary);
}

.aboutus-hl-frosh-group {
  font-size: 40px;
  margin-bottom: 5px;
  font-family: "Genty", sans-serif;
}

.aboutus-hl-contacts-container {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.aboutus-hl-contacts-icon {
  width: 50px;
  margin: 10px;
  transition: transform 300ms;
}
.aboutus-hl-contacts-icon:hover {
  transform: scale(1.07);
}
.aboutus-hl-contacts-icon:active {
  transform: scale(0.97);
}
@media only screen and (max-width: 767px) {
  .aboutus-hl-contacts-icon {
    width: 40px;
    margin: 5px;
  }
}

.aboutus-leedur {
  text-align: center;
  margin: 3px;
  color: var(--leedur-names);
  font-family: "Gliker", sans-serif;
}

.aboutus-leedur-contact-message {
  margin: 10px 3% 0 3%;
  font-family: "Gliker", sans-serif;
}
@media only screen and (max-width: 767px) {
  .aboutus-leedur-contact-message {
    font-size: 12px;
  }
}

.aboutus-commitee-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 50px;
}
@media only screen and (max-width: 767px) {
  .aboutus-commitee-container {
    margin: 25px 0;
  }
}

.aboutus-subcom-grid-container {
  display: grid;
  width: 90vw;
  grid-template-columns: repeat(auto-fit, 450px);
  align-items: center;
  justify-items: center;
  justify-content: center;
  margin-bottom: 25px;
}
@media only screen and (max-width: 767px) {
  .aboutus-subcom-grid-container {
    grid-template-columns: auto auto;
  }
}

.aboutus-subcom {
  text-align: center;
  color: var(--black);
  margin-bottom: 20px;
  font-family: "Gliker", sans-serif;
}

.aboutus-arrows {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.aboutus-arrow-btn {
  background-color: #ffffff;
  color: #6f1f85;
  font-family: "Gliker", sans-serif;
  border: 0px solid rgba(111, 31, 133, 0);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  font-size: 24px;
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
}
.aboutus-arrow-btn:hover {
  background-color: #6f1f85;
  color: #fcc606;
}

.team-slide {
  background-color: #fff;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
  text-align: center;
}

.slick-dots li button:before {
  color: var(--purple-shades-dark);
}

.slick-dots li.slick-active button:before {
  color: #f3d384;
}

.slick-prev:before,
.slick-next:before {
  color: var(--purple-shades-dark);
}

.carousel .slide {
  display: flex;
  justify-content: center;
}

.carousel-slide-container {
  padding: 20px;
}

.carousel-slide-border {
  padding: 15px;
  border-radius: 15px;
  margin-bottom: 55px;
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
  height: 300px;
}
@media only screen and (max-width: 767px) {
  .carousel-slide-border {
    width: 100%;
    margin-bottom: 40px;
    height: 240px;
  }
}

.carousel-slide {
  background-color: var(--white);
  padding: 15px;
  border-radius: 15px;
  margin-bottom: 55px;
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
  height: 270px;
  object-fit: contain;
}
@media only screen and (max-width: 767px) {
  .carousel-slide {
    width: 80%;
    margin-bottom: 40px;
    height: 210px;
  }
}

.control-dots .dot {
  background: var(--control-dot) !important;
  box-shadow: unset !important;
  width: 40px !important;
  height: 6px !important;
  margin: 0 !important;
  border-radius: 0 !important;
}
@media only screen and (max-width: 767px) {
  .control-dots .dot {
    width: 20px !important;
    height: 5px !important;
  }
}

.carousel-link {
  background: none;
  display: block;
  transition: transform 300ms;
}
.carousel-link:hover {
  transform: scale(1.05);
}

.all-teams-tabs-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.aboutus-tabs-component {
  width: 100%;
}

.aboutus-teams-carousel {
  margin: 20px auto;
  max-width: 800px;
}

.aboutus-teams-carousel-tab {
  padding: 10px;
  border-radius: 5px;
  background-color: #f0f0f0;
  margin-right: 10px;
  cursor: url("../../assets/cursor/pointer.png"), auto !important;
  transition: background-color 0.3s ease;
}
.aboutus-teams-carousel-tab h1 {
  margin: 0;
  font-size: 16px;
  color: #333;
}
.aboutus-teams-carousel-tab.active {
  background-color: #007bff;
}
.aboutus-teams-carousel-tab.active h1 {
  color: #fff;
}

@keyframes shake {
  0% {
    transform: translate(1px, 1px) rotate(0deg);
  }
  10% {
    transform: translate(-1px, -2px) rotate(-1deg);
  }
  20% {
    transform: translate(-3px, 0px) rotate(1deg);
  }
  30% {
    transform: translate(3px, 2px) rotate(0deg);
  }
  40% {
    transform: translate(1px, -1px) rotate(1deg);
  }
  50% {
    transform: translate(-1px, 2px) rotate(-1deg);
  }
  60% {
    transform: translate(-3px, 1px) rotate(0deg);
  }
  70% {
    transform: translate(3px, 1px) rotate(-1deg);
  }
  80% {
    transform: translate(-1px, -1px) rotate(1deg);
  }
  90% {
    transform: translate(1px, 2px) rotate(0deg);
  }
  100% {
    transform: translate(1px, -2px) rotate(-1deg);
  }
}
.shake-animation {
  animation: shake 0.5s ease-in-out infinite;
}

.aboutus-hero {
  display: flex;
  align-items: stretch;
  width: 100%;
  min-height: 450px;
  background-color: #3D0f58;
  overflow: hidden;
  position: relative;
}

.aboutus-checkerboard-container {
  position: absolute;
  right: 0;
  top: 0;
  width: 70%;
  height: 100%;
  z-index: 1;
  background-image: repeating-conic-gradient(#FFFFFF 0% 25%, #3D0f58 0% 50%);
  background-size: 150px 150px;
  -webkit-mask-image: linear-gradient(135deg, transparent 30.5%, #000 30.5%), linear-gradient(to right, transparent 0%, #000 50%);
  -webkit-mask-composite: source-in;
  mask-image: linear-gradient(135deg, transparent 30.5%, #000 30.5%), linear-gradient(to right, transparent 0%, #000 50%);
  mask-composite: intersect;
}
@media only screen and (max-width: 767px) {
  .aboutus-checkerboard-container {
    background-size: 115px 114px;
  }
}

